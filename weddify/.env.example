# Port, auf dem der Server lauscht
PORT=3000
# Ordner für die SQLite-Datenbank (wird angelegt)
DATA_DIR=./data
# Auf 1 setzen, sobald die Seite per HTTPS erreichbar ist (Reverse Proxy)
COOKIE_SECURE=0
# Öffentliche Adresse, wird in Einladungs- und Kalenderlinks verwendet
PUBLIC_URL=http://localhost:3000
